<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlazingJoker" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/bj_black</item>
        <item name="android:navigationBarColor">@color/bj_black</item>
        <item name="android:windowBackground">@color/bj_black</item>
    </style>

    <style name="Theme.BlazingJoker.Fullscreen" parent="Theme.BlazingJoker">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
        Launch theme — used ONLY by the LoadingActivity manifest entry.
        Extends the AndroidX SplashScreen compat theme so the Android 12+
        system splash renders the adaptive icon without a white frame flash.
    -->
    <style name="Theme.BlazingJoker.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/link_launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.BlazingJoker.Fullscreen</item>
    </style>
</resources>
