<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon — used by both the launcher AND the Android 12+ splash
    (via windowSplashScreenAnimatedIcon in Theme.BlazingJoker.Launch).

    background  = @color/link_launch_bg — dark tone matching Icon's corners
                  so no white bezel appears under any mask.
    foreground  = @mipmap/ic_launcher_foreground — Icon.png rendered inside
                  the safe zone (14% inset per side, so ~72% coverage).

    Do NOT swap the foreground to a full-bleed PNG — a circular / squircle /
    teardrop mask would then clip the character. Do NOT use a plain drawable
    for splash — Android 12+ silently falls back to the launcher icon
    unless the referenced resource is an <adaptive-icon>.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/link_launch_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
